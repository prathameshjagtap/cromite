+package org.chromium.chrome.browser.headless;
+
+import android.graphics.Color;
+import android.view.View;
+import android.view.ViewGroup;
+
+import org.jni_zero.CalledByNative;
+
+import org.chromium.base.ThreadUtils;
+import org.chromium.chrome.browser.flags.cromite.sHeadlessAutomationMode;
+import org.chromium.content_public.browser.WebContents;
+import org.chromium.ui.base.ViewAndroidDelegate;
+
+/**
+ * Bridges the window.cromite.setContentVisible / isContentVisible private API
+ * to an opaque overlay placed on top of the WebContents container view. The
+ * renderer keeps compositing while hidden, so automation continues to work.
+ */
+public class CromiteHeadlessBridge {
+    /** Opaque marker view so we can find our overlay among the children. */
+    private static class HeadlessOverlay extends View {
+        HeadlessOverlay(android.content.Context context) {
+            super(context);
+            setBackgroundColor(Color.BLACK);
+            // Automation input is injected through the renderer, not Android
+            // hit-testing, so the overlay does not need to be click-through.
+            setClickable(false);
+            setFocusable(false);
+        }
+    }
+
+    private CromiteHeadlessBridge() {}
+
+    @CalledByNative
+    private static void setContentVisible(WebContents webContents, boolean visible) {
+        ThreadUtils.runOnUiThread(() -> applyVisibility(webContents, visible));
+    }
+
+    @CalledByNative
+    private static boolean isContentVisible(WebContents webContents) {
+        HeadlessOverlay overlay = findOverlay(webContents);
+        return overlay == null || overlay.getVisibility() != View.VISIBLE;
+    }
+
+    private static ViewGroup getContainer(WebContents webContents) {
+        if (webContents == null) return null;
+        ViewAndroidDelegate delegate = webContents.getViewAndroidDelegate();
+        if (delegate == null) return null;
+        View container = delegate.getContainerView();
+        return (container instanceof ViewGroup) ? (ViewGroup) container : null;
+    }
+
+    private static HeadlessOverlay findOverlay(WebContents webContents) {
+        ViewGroup container = getContainer(webContents);
+        if (container == null) return null;
+        for (int i = 0; i < container.getChildCount(); i++) {
+            View child = container.getChildAt(i);
+            if (child instanceof HeadlessOverlay) {
+                return (HeadlessOverlay) child;
+            }
+        }
+        return null;
+    }
+
+    private static void applyVisibility(WebContents webContents, boolean visible) {
+        ViewGroup container = getContainer(webContents);
+        if (container == null) return;
+
+        HeadlessOverlay overlay = findOverlay(webContents);
+        if (visible) {
+            if (overlay != null) overlay.setVisibility(View.GONE);
+            return;
+        }
+
+        if (overlay == null) {
+            overlay = new HeadlessOverlay(container.getContext());
+            container.addView(overlay,
+                new ViewGroup.LayoutParams(
+                    ViewGroup.LayoutParams.MATCH_PARENT,
+                    ViewGroup.LayoutParams.MATCH_PARENT));
+        }
+        overlay.setVisibility(View.VISIBLE);
+        overlay.bringToFront();
+    }
+
+    /** Whether contents should start hidden for this session. */
+    @CalledByNative
+    private static boolean isHeadlessModeEnabled() {
+        return sHeadlessAutomationMode.getInstance().isEnabled();
+    }
+}
