+package org.chromium.chrome.browser.headless;
+
+import android.view.View;
+import android.webkit.JavascriptInterface;
+import android.webkit.WebView;
+
+import org.chromium.base.ThreadUtils;
+import org.chromium.content_public.browser.WebContents;
+
+import org.json.JSONObject;
+
+/**
+ * Low-level automation primitives exposed to the harness page as "automationNative".
+ *
+ * Philosophy: keep logic in JavaScript (harness.html owns flows, the run loop, and
+ * flow CRUD). This bridge only offers granular, human-like primitives that drive the
+ * *tab* WebContents and report results back to the harness.
+ *
+ * Threading: @JavascriptInterface methods run on a WebView binder thread; everything
+ * is marshalled to the UI thread. Each call carries a numeric callback id; the result
+ * is delivered back into the harness via window.__automationResolve(id, jsonOrValue).
+ */
+public class AutomationBridge {
+    private final View mOverlay;
+    private final WebView mHarnessWebView;
+    private final WebContents mTab;
+    private final AutomationEngine mEngine;
+
+    AutomationBridge(View overlay, WebView harnessWebView, WebContents tab) {
+        mOverlay = overlay;
+        mHarnessWebView = harnessWebView;
+        mTab = tab;
+        mEngine = new AutomationEngine(tab);
+    }
+
+    // ---- visibility: the harness "Show browser" / "Show progress" controls -------------
+
+    @JavascriptInterface
+    public void showBrowser() {
+        ThreadUtils.runOnUiThread(() -> mOverlay.setVisibility(View.GONE));
+    }
+
+    @JavascriptInterface
+    public void hideBrowser() {
+        ThreadUtils.runOnUiThread(() -> {
+            mOverlay.setVisibility(View.VISIBLE);
+            mOverlay.bringToFront();
+        });
+    }
+
+    // ---- primitives (logic stays in the harness; these are the building blocks) --------
+
+    @JavascriptInterface
+    public void navigate(String url, int id) {
+        ThreadUtils.runOnUiThread(() -> mEngine.navigate(url, ok -> resolveBool(id, ok)));
+    }
+
+    @JavascriptInterface
+    public void waitForSelector(String selector, int timeoutMs, int id) {
+        ThreadUtils.runOnUiThread(
+            () -> mEngine.waitForSelector(selector, timeoutMs, found -> resolveBool(id, found)));
+    }
+
+    @JavascriptInterface
+    public void evaluate(String js, int id) {
+        ThreadUtils.runOnUiThread(() -> mEngine.evaluate(js, json -> resolveRaw(id, json)));
+    }
+
+    @JavascriptInterface
+    public void tap(String selector, int id) {
+        ThreadUtils.runOnUiThread(() -> mEngine.tap(selector, ok -> resolveBool(id, ok)));
+    }
+
+    @JavascriptInterface
+    public void type(String selector, String text, int id) {
+        ThreadUtils.runOnUiThread(() -> mEngine.type(selector, text, ok -> resolveBool(id, ok)));
+    }
+
+    @JavascriptInterface
+    public void scrollTo(String selector, int id) {
+        ThreadUtils.runOnUiThread(() -> mEngine.scrollTo(selector, ok -> resolveBool(id, ok)));
+    }
+
+    @JavascriptInterface
+    public void sleep(int ms, int id) {
+        mHarnessWebView.postDelayed(() -> resolveBool(id, true), ms);
+    }
+
+    @JavascriptInterface
+    public void cancel() {
+        ThreadUtils.runOnUiThread(mEngine::cancel);
+    }
+
+    // ---- result plumbing ---------------------------------------------------------------
+
+    private void resolveBool(int id, boolean value) {
+        resolveRaw(id, value ? "true" : "false");
+    }
+
+    /** json must be a valid JS literal (true/false/number/quoted string/JSON object). */
+    private void resolveRaw(int id, String jsonLiteral) {
+        final String literal = jsonLiteral == null ? "null" : jsonLiteral;
+        ThreadUtils.runOnUiThread(() -> {
+            String call = "window.__automationResolve && window.__automationResolve("
+                + id + "," + literal + ");";
+            mHarnessWebView.evaluateJavascript(call, null);
+        });
+    }
+
+    /** Helper for engine→harness events (status/progress/failure). */
+    void emit(String event, JSONObject payload) {
+        final String json = payload == null ? "null" : payload.toString();
+        ThreadUtils.runOnUiThread(() -> {
+            String call = "window.automation && window.automation." + event
+                + " && window.automation." + event + "(" + json + ");";
+            mHarnessWebView.evaluateJavascript(call, null);
+        });
+    }
+}
