+
+void CromitePrivateApiExtension::SetContentVisible(gin::Arguments* args) {
+  bool visible;
+  if (!args->GetNext(&visible)) {
+    args->ThrowError();
+    return;
+  }
+
+  if (!remote_.is_bound()) {
+    render_frame()->GetRemoteAssociatedInterfaces()->GetInterface(&remote_);
+  }
+
+  remote_->SetContentVisible(visible);
+}
+
+void CromitePrivateApiExtension::IsContentVisible(gin::Arguments* args) {
+  v8::Isolate* isolate = args->isolate();
+  v8::Local<v8::Context> context = isolate->GetCurrentContext();
+  v8::Local<v8::Promise::Resolver> resolver =
+      v8::Promise::Resolver::New(context).ToLocalChecked();
+
+  base::UnguessableToken callback_id = base::UnguessableToken::Create();
+  pending_requests_[callback_id] =
+      std::make_unique<PendingRequest>(isolate, context, resolver);
+
+  if (!remote_.is_bound()) {
+    render_frame()->GetRemoteAssociatedInterfaces()->GetInterface(&remote_);
+  }
+
+  remote_->IsContentVisible(
+      base::BindOnce(&CromitePrivateApiExtension::OnIsContentVisible,
+                     weak_ptr_factory_.GetWeakPtr(), callback_id));
+
+  args->Return(resolver->GetPromise());
+}
+
+void CromitePrivateApiExtension::OnIsContentVisible(
+    const base::UnguessableToken callback_id, bool visible) {
+  auto it = pending_requests_.find(callback_id);
+  if (it == pending_requests_.end())
+    return;
+  std::unique_ptr<PendingRequest> request = std::move(it->second);
+  pending_requests_.erase(it);
+
+  v8::Isolate* isolate = request->isolate;
+  v8::HandleScope handle_scope(isolate);
+  v8::Local<v8::Context> context = request->context.Get(isolate);
+  v8::Context::Scope context_scope(context);
+  v8::Local<v8::Promise::Resolver> resolver =
+      request->promise_resolver.Get(isolate);
+  resolver->Resolve(context, v8::Boolean::New(isolate, visible)).Check();
+}
