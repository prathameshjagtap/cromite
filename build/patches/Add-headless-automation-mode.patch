+package org.chromium.chrome.browser.headless;
+
+import android.annotation.SuppressLint;
+import android.graphics.Color;
+import android.view.View;
+import android.view.ViewGroup;
+import android.webkit.WebView;
+import android.widget.FrameLayout;
+
+import org.jni_zero.CalledByNative;
+
+import org.chromium.base.ThreadUtils;
+import org.chromium.chrome.browser.flags.cromite.sHeadlessAutomationMode;
+import org.chromium.content_public.browser.WebContents;
+import org.chromium.ui.base.ViewAndroidDelegate;
+
+/**
+ * Hosts the on-device automation harness on top of a tab's WebContents.
+ *
+ * The overlay is an opaque {@link FrameLayout} containing a {@link WebView} that
+ * loads the bundled harness page (file:///android_asset/cromite_automation/harness.html).
+ * The harness owns all flow logic in JavaScript and talks to the native automation
+ * primitives through the "automationNative" {@link AutomationBridge}.
+ *
+ * Visibility is a simple toggle between the harness (overlay shown) and the live
+ * web contents (overlay gone). The renderer keeps compositing underneath while the
+ * overlay is shown, so automation continues to work.
+ */
+public class CromiteHeadlessBridge {
+    private static final String HARNESS_URL =
+        "file:///android_asset/cromite_automation/harness.html";
+
+    /** Opaque container we can find again among the WebContents container children. */
+    private static class HarnessOverlay extends FrameLayout {
+        final WebView webView;
+        final AutomationBridge bridge;
+
+        @SuppressLint({"SetJavaScriptEnabled", "AddJavascriptInterface"})
+        HarnessOverlay(WebContents webContents) {
+            super(webContents.getViewAndroidDelegate().getContainerView().getContext());
+            setBackgroundColor(Color.BLACK);
+            setClickable(true);
+            setFocusable(true);
+
+            webView = new WebView(getContext());
+            webView.getSettings().setJavaScriptEnabled(true);
+            webView.getSettings().setDomStorageEnabled(true);
+            webView.getSettings().setAllowFileAccess(true);
+            // The automation engine drives the *tab* WebContents; the bridge marshals
+            // calls onto the UI thread and reports results back into this WebView.
+            bridge = new AutomationBridge(this, webView, webContents);
+            webView.addJavascriptInterface(bridge, "automationNative");
+            webView.loadUrl(HARNESS_URL);
+
+            addView(webView,
+                new FrameLayout.LayoutParams(
+                    ViewGroup.LayoutParams.MATCH_PARENT,
+                    ViewGroup.LayoutParams.MATCH_PARENT));
+        }
+    }
+
+    private CromiteHeadlessBridge() {}
+
+    /** Show/hide the live web contents. visible == true reveals the page (overlay GONE). */
+    @CalledByNative
+    private static void setContentVisible(WebContents webContents, boolean visible) {
+        ThreadUtils.runOnUiThread(() -> applyVisibility(webContents, visible));
+    }
+
+    @CalledByNative
+    private static boolean isContentVisible(WebContents webContents) {
+        HarnessOverlay overlay = findOverlay(webContents);
+        return overlay == null || overlay.getVisibility() != View.VISIBLE;
+    }
+
+    /** Whether the harness should be attached for this session. */
+    @CalledByNative
+    private static boolean isHeadlessModeEnabled() {
+        return sHeadlessAutomationMode.getInstance().isEnabled();
+    }
+
+    /**
+     * Attaches (once) the harness overlay to the tab and shows it. Call this from the
+     * tab/activity init path when the flag is enabled. Idempotent per WebContents.
+     */
+    public static void attachHarness(WebContents webContents) {
+        if (!sHeadlessAutomationMode.getInstance().isEnabled()) return;
+        ThreadUtils.runOnUiThread(() -> applyVisibility(webContents, false));
+    }
+
+    static void runOnUiThread(Runnable r) {
+        ThreadUtils.runOnUiThread(r);
+    }
+
+    private static ViewGroup getContainer(WebContents webContents) {
+        if (webContents == null) return null;
+        ViewAndroidDelegate delegate = webContents.getViewAndroidDelegate();
+        if (delegate == null) return null;
+        View container = delegate.getContainerView();
+        return (container instanceof ViewGroup) ? (ViewGroup) container : null;
+    }
+
+    private static HarnessOverlay findOverlay(WebContents webContents) {
+        ViewGroup container = getContainer(webContents);
+        if (container == null) return null;
+        for (int i = 0; i < container.getChildCount(); i++) {
+            View child = container.getChildAt(i);
+            if (child instanceof HarnessOverlay) {
+                return (HarnessOverlay) child;
+            }
+        }
+        return null;
+    }
+
+    private static void applyVisibility(WebContents webContents, boolean visible) {
+        ViewGroup container = getContainer(webContents);
+        if (container == null) return;
+
+        HarnessOverlay overlay = findOverlay(webContents);
+        if (visible) {
+            if (overlay != null) overlay.setVisibility(View.GONE);
+            return;
+        }
+
+        if (overlay == null) {
+            overlay = new HarnessOverlay(webContents);
+            container.addView(overlay,
+                new ViewGroup.LayoutParams(
+                    ViewGroup.LayoutParams.MATCH_PARENT,
+                    ViewGroup.LayoutParams.MATCH_PARENT));
+        }
+        overlay.setVisibility(View.VISIBLE);
+        overlay.bringToFront();
+    }
+}
