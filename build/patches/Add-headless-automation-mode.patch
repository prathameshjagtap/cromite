+void CromitePrivateApiHost::SetContentVisible(bool visible) {
+  content::WebContents* web_contents =
+      content::WebContents::FromRenderFrameHost(&render_frame_host());
+  if (!web_contents)
+    return;
+
+  JNIEnv* env = base::android::AttachCurrentThread();
+  Java_CromiteHeadlessBridge_setContentVisible(
+      env, web_contents->GetJavaWebContents(), visible);
+}
+
+void CromitePrivateApiHost::IsContentVisible(
+    IsContentVisibleCallback callback) {
+  content::WebContents* web_contents =
+      content::WebContents::FromRenderFrameHost(&render_frame_host());
+  if (!web_contents) {
+    std::move(callback).Run(true);
+    return;
+  }
+
+  JNIEnv* env = base::android::AttachCurrentThread();
+  bool visible = Java_CromiteHeadlessBridge_isContentVisible(
+      env, web_contents->GetJavaWebContents());
+  std::move(callback).Run(visible);
+}
